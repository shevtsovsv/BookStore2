# Режим работы (production для боевого сервера)
NODE_ENV=production

# Порт сервера
PORT=3000

# JWT настройки (ОБЯЗАТЕЛЬНО изменить на production!)
JWT_SECRET=CHANGE-THIS-TO-VERY-LONG-RANDOM-STRING-FOR-PRODUCTION-64-CHARS-MIN
JWT_EXPIRES_IN=24h

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookstore_prod
DB_USER=bookstore_user
DB_PASSWORD=YOUR-SECURE-DATABASE-PASSWORD-HERE

# Полный URL базы данных (альтернатива отдельным параметрам)
# DATABASE_URL=postgresql://bookstore_user:password@localhost:5432/bookstore_prod

# Безопасность
BCRYPT_SALT_ROUNDS=14

# CORS настройки (замените на ваш домен)
CORS_ORIGIN=https://yourdomain.com

# Логирование
LOG_LEVEL=error
LOG_FILE=/var/log/bookstore/app.log

# Опционально: SSL настройки
# SSL_CERT_PATH=/etc/ssl/certs/yourdomain.crt
# SSL_KEY_PATH=/etc/ssl/private/yourdomain.key

# Опционально: Email настройки (для уведомлений)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Опционально: Redis для кеширования
# REDIS_URL=redis://localhost:6379